<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="FactureClient" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"><!-- ===== STYLES ===== -->
	<style name="Title" fontName="Arial" fontSize="20.0" isBold="true" forecolor="#1A237E"/>
	<style name="SectionTitle" fontName="Arial" fontSize="11.0" isBold="true" forecolor="#FFFFFF"/>
	<style name="Label" fontName="Arial" fontSize="10.0" isBold="true" forecolor="#333333"/>
	<style name="Value" fontName="Arial" fontSize="10.0" isBold="false" forecolor="#000000"/>
	<style name="ValueBold" fontName="Arial" fontSize="10.0" isBold="true" forecolor="#000000"/>
	<style name="TotalLabel" fontName="Arial" fontSize="11.0" isBold="true" forecolor="#1A237E"/>
	<style name="TotalValue" fontName="Arial" fontSize="11.0" isBold="true" forecolor="#1A237E"/>
	<style name="Footer" fontName="Arial" fontSize="9.0" isBold="false" forecolor="#666666"/>

	<!-- ===== PARAMETERS ===== -->
	<parameter name="facturesClientReference" class="java.lang.Integer"/>
	<parameter name="facturesClientNumero" class="java.lang.Integer"/>
	<parameter name="facturesClientMontantDevise" class="java.lang.Double"/>
	<parameter name="facturesClientTauxChange" class="java.lang.Float"/>
	<parameter name="facturesClientHT" class="java.lang.Double"/>
	<parameter name="facturesClientTVA" class="java.lang.Float"/>
	<parameter name="facturesClientTTC" class="java.lang.Double"/>
	<parameter name="facturesClientTimbre" class="java.lang.Float"/>
	<parameter name="facturesClientTotalFacture" class="java.lang.Double"/>
	<parameter name="facturesClientRSTVAPourcentage" class="java.lang.Float"/>
	<parameter name="facturesClientRSTVA" class="java.lang.Float"/>
	<parameter name="facturesClientRSPourcentage" class="java.lang.Float"/>
	<parameter name="facturesClientRS" class="java.lang.Float"/>
	<parameter name="facturesClientRSTotal" class="java.lang.Double"/>
	<parameter name="facturesClientMontantARecevoir" class="java.lang.Double"/>
	<parameter name="facturesClientMontantVerse" class="java.lang.Double"/>
	<parameter name="facturesClientMontantEcart" class="java.lang.Double"/>
	<parameter name="clientNom"                    class="java.lang.String"/>
	<parameter name="clientReference"                class="java.lang.Integer"/>
	<parameter name="deviseCode"                   class="java.lang.String"/>
	<parameter name="categorieNom"                 class="java.lang.String"/>

	<queryString language="sql"><![CDATA[]]></queryString>

	<!-- ===== TITLE BAND ===== -->
	<title>
		<band height="90" splitType="Stretch">

			<!-- Blue header bar -->
			<rectangle><reportElement x="0" y="0" width="555" height="60" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><!-- Company / report title -->
			<staticText><reportElement x="10" y="8" width="340" height="30" forecolor="#FFFFFF" style="Title"/><textElement><font size="20.0"/></textElement><text><![CDATA[FACTURE CLIENT]]></text>
			</staticText><!-- Invoice number -->
			<textField><reportElement x="10" y="38" width="340" height="18" forecolor="#BBDEFB" style="Value"/><textElement><font size="11.0"/></textElement><textFieldExpression><![CDATA["N° " + $P{facturesClientNumero}]]></textFieldExpression>
			</textField><!-- Reference box top-right -->
			<rectangle><reportElement x="390" y="5" width="165" height="50" mode="Opaque" forecolor="#E3F2FD" backcolor="#E3F2FD"/><graphicElement/></rectangle><staticText><reportElement x="395" y="8" width="155" height="16" forecolor="#1A237E" style="Label"/><textElement><font size="9.0"/></textElement><text><![CDATA[Référence]]></text>
		</staticText><textField><reportElement x="395" y="24" width="155" height="18" forecolor="#1A237E" style="Label"/><textElement><font size="13.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientReference}]]></textFieldExpression>
		</textField><!-- Réf. Client -->
			<staticText><reportElement x="395" y="58" width="70" height="14" forecolor="#1A237E" style="Label"/><textElement><font size="9.0"/></textElement><text><![CDATA[Réf. Client :]]></text>
			</staticText><textField><reportElement x="470" y="58" width="85" height="14" forecolor="#1A237E" style="Value"/><textElement textAlignment="Right"><font size="9.0"/></textElement><textFieldExpression><![CDATA[$P{clientReference} != null ? $P{clientReference} : "-"]]></textFieldExpression>
		</textField><!-- Date -->
			<textField><reportElement x="390" y="75" width="165" height="15" forecolor="#666666" style="Footer"/><textElement textAlignment="Right"><font size="9.0"/></textElement><textFieldExpression><![CDATA["Date : " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
			</textField></band>
	</title>

	<!-- ===== PAGE HEADER ===== -->
	<pageHeader>
		<band height="8" splitType="Stretch">
			<line><reportElement x="0" y="5" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line></band>
	</pageHeader>

	<!-- ===== DETAIL BAND (single-pass with all sections) ===== -->
	<detail>
		<band height="630" splitType="Stretch">

			<!-- =========================================================== -->
			<!-- SECTION 1 : CLIENT INFO                                      -->
			<!-- =========================================================== -->
			<!-- Section header bar -->
			<rectangle><reportElement x="0" y="0" width="555" height="20" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="2" width="300" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="10.0"/></textElement><text><![CDATA[INFORMATIONS CLIENT]]></text>
		</staticText><!-- Client Name -->
			<staticText><reportElement x="5" y="28" width="120" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Client :]]></text>
			</staticText><textField><reportElement x="130" y="28" width="280" height="16" style="Value"/><textElement><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{clientNom} != null ? $P{clientNom} : "-"]]></textFieldExpression>
		</textField><!-- Devise -->
			<staticText><reportElement x="5" y="48" width="120" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Devise :]]></text>
			</staticText><textField><reportElement x="130" y="48" width="200" height="16" style="Value"/><textElement><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{deviseCode} != null ? $P{deviseCode} : "-"]]></textFieldExpression>
		</textField><!-- Categorie -->
			<staticText><reportElement x="5" y="68" width="120" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Catégorie :]]></text>
			</staticText><textField><reportElement x="130" y="68" width="280" height="16" style="Value"/><textElement><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{categorieNom} != null ? $P{categorieNom} : "-"]]></textFieldExpression>
		</textField><!-- separator -->
			<line><reportElement x="0" y="92" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line><!-- =========================================================== -->
			<!-- SECTION 2 : MONTANTS DEVISE                                  -->
			<!-- =========================================================== -->
			<rectangle><reportElement x="0" y="100" width="555" height="20" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="102" width="300" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="10.0"/></textElement><text><![CDATA[MONTANTS EN DEVISE]]></text>
		</staticText><!-- Montant Devise -->
			<staticText><reportElement x="5" y="128" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Montant Devise :]]></text>
			</staticText><textField pattern=" #,##0.000 'DT'"><reportElement x="280" y="128" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientMontantDevise}]]></textFieldExpression>
		</textField><!-- Taux de change -->
			<staticText><reportElement x="5" y="148" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Taux de Change :]]></text>
			</staticText><textField pattern="#,##0.0000"><reportElement x="280" y="148" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientTauxChange}]]></textFieldExpression>
		</textField><!-- separator -->
			<line><reportElement x="0" y="172" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line><!-- =========================================================== -->
			<!-- SECTION 3 : MONTANTS TND                                     -->
			<!-- =========================================================== -->
			<rectangle><reportElement x="0" y="180" width="555" height="20" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="182" width="300" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="10.0"/></textElement><text><![CDATA[MONTANTS (TND)]]></text>
		</staticText><!-- HT -->
			<staticText><reportElement x="5" y="208" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Montant HT :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="208" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientHT}]]></textFieldExpression>
		</textField><!-- TVA -->
			<staticText><reportElement x="5" y="228" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[TVA :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="228" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientTVA}]]></textFieldExpression>
		</textField><!-- TTC -->
			<rectangle><reportElement x="0" y="248" width="555" height="20" mode="Opaque" forecolor="#E8EAF6" backcolor="#E8EAF6"/><graphicElement/></rectangle><staticText><reportElement x="5" y="250" width="200" height="16" style="TotalLabel"/><textElement><font size="10.0"/></textElement><text><![CDATA[Montant TTC :]]></text>
		</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="250" width="150" height="16" style="ValueBold"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientTTC}]]></textFieldExpression>
		</textField><!-- Timbre -->
			<staticText><reportElement x="5" y="278" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Timbre :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="278" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientTimbre}]]></textFieldExpression>
		</textField><!-- Total Facture -->
			<rectangle><reportElement x="0" y="298" width="555" height="22" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="301" width="200" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="11.0"/></textElement><text><![CDATA[TOTAL FACTURE :]]></text>
		</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="301" width="150" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement textAlignment="Right"><font size="11.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientTotalFacture}]]></textFieldExpression>
		</textField><!-- separator -->
			<line><reportElement x="0" y="330" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line><!-- =========================================================== -->
			<!-- SECTION 4 : RETENUES À LA SOURCE (RS)                        -->
			<!-- =========================================================== -->
			<rectangle><reportElement x="0" y="338" width="555" height="20" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="340" width="350" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="10.0"/></textElement><text><![CDATA[RETENUES À LA SOURCE (RS)]]></text>
		</staticText><!-- RS TVA % -->
			<staticText><reportElement x="5" y="366" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[RS TVA % :]]></text>
			</staticText><textField pattern="#,##0.00 '%'"><reportElement x="280" y="366" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientRSTVAPourcentage}]]></textFieldExpression>
		</textField><!-- RS TVA -->
			<staticText><reportElement x="5" y="386" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[RS TVA :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="386" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientRSTVA}]]></textFieldExpression>
		</textField><!-- RS % -->
			<staticText><reportElement x="5" y="406" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[RS % :]]></text>
			</staticText><textField pattern="#,##0.00 '%'"><reportElement x="280" y="406" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientRSPourcentage}]]></textFieldExpression>
		</textField><!-- RS -->
			<staticText><reportElement x="5" y="426" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[RS :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="426" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientRS}]]></textFieldExpression>
		</textField><!-- RS Total -->
			<rectangle><reportElement x="0" y="446" width="555" height="20" mode="Opaque" forecolor="#E8EAF6" backcolor="#E8EAF6"/><graphicElement/></rectangle><staticText><reportElement x="5" y="448" width="200" height="16" style="TotalLabel"/><textElement><font size="10.0"/></textElement><text><![CDATA[RS Total :]]></text>
		</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="448" width="150" height="16" style="TotalValue"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientRSTotal}]]></textFieldExpression>
		</textField><!-- separator -->
			<line><reportElement x="0" y="476" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line><!-- =========================================================== -->
			<!-- SECTION 5 : RÈGLEMENT                                        -->
			<!-- =========================================================== -->
			<rectangle><reportElement x="0" y="484" width="555" height="20" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="5" y="486" width="300" height="16" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="10.0"/></textElement><text><![CDATA[RÈGLEMENT]]></text>
		</staticText><!-- À Recevoir -->
			<staticText><reportElement x="5" y="512" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[À Recevoir :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="512" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientMontantARecevoir}]]></textFieldExpression>
		</textField><!-- Versé -->
			<staticText><reportElement x="5" y="532" width="200" height="16" style="Label"/><textElement><font size="10.0"/></textElement><text><![CDATA[Versé :]]></text>
			</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="532" width="150" height="16" style="Value"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientMontantVerse}]]></textFieldExpression>
		</textField><!-- Écart -->
			<rectangle><reportElement x="0" y="552" width="555" height="22" mode="Opaque" forecolor="#E8EAF6" backcolor="#E8EAF6"/><graphicElement/></rectangle><staticText><reportElement x="5" y="555" width="200" height="16" style="TotalLabel"/><textElement><font size="10.0"/></textElement><text><![CDATA[Écart :]]></text>
		</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="555" width="150" height="16" style="TotalValue"/><textElement textAlignment="Right"><font size="10.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientMontantEcart}]]></textFieldExpression>
		</textField><!-- =========================================================== -->
			<!-- DIVIDER BEFORE GRAND TOTAL                                   -->
			<!-- =========================================================== -->
			<line><reportElement x="0" y="585" width="555" height="1"/><graphicElement><pen lineWidth="1.0" lineColor="#1A237E"/>
			</graphicElement></line><!-- NET À RECEVOIR grand total box -->
			<rectangle><reportElement x="0" y="592" width="555" height="28" mode="Opaque" forecolor="#1A237E" backcolor="#1A237E"/><graphicElement/></rectangle><staticText><reportElement x="10" y="596" width="250" height="20" forecolor="#FFFFFF" style="SectionTitle"/><textElement><font size="12.0"/></textElement><text><![CDATA[NET À RECEVOIR :]]></text>
		</staticText><textField pattern="#,##0.000 'DT'"><reportElement x="280" y="596" width="150" height="20" forecolor="#FFFFFF" style="SectionTitle"/><textElement textAlignment="Right"><font size="12.0"/></textElement><textFieldExpression><![CDATA[$P{facturesClientMontantARecevoir}]]></textFieldExpression>
		</textField></band>
	</detail>

	<!-- ===== PAGE FOOTER ===== -->
	<pageFooter>
		<band height="30" splitType="Stretch">
			<line><reportElement x="0" y="0" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/>
			</graphicElement></line><staticText><reportElement x="0" y="6" width="200" height="16" style="Footer"/><textElement><font size="8.0"/></textElement><text><![CDATA[Généré automatiquement - Application Comptabilité]]></text>
		</staticText><textField><reportElement x="200" y="6" width="200" height="16" style="Footer"/><textElement textAlignment="Center"><font size="8.0"/></textElement><textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
		</textField><textField><reportElement x="430" y="6" width="125" height="16" style="Footer"/><textElement textAlignment="Right"><font size="8.0"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / " + $V{PAGE_COUNT}]]></textFieldExpression>
		</textField></band>
	</pageFooter>

</jasperReport>
